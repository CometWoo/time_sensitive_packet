# experiment.env.example — deploy-experiment.sh / verify-experiment.sh 설정
#
#   cp experiment.env.example experiment.env   # 그리고 값을 편집
#
# 두 스크립트는 저장소 루트의 ./experiment.env 를 KEY=VALUE 줄 단위로 읽는다 (source 가 아니라 파싱:
# '#' 뒤는 주석, 따옴표는 벗겨짐, 빈 값은 "기본값/자동 감지"). 환경변수로 넘긴 값이 파일보다 우선하고,
# EXPERIMENT_ENV=/path/other.env 로 다른 파일을 지정할 수 있다.

# ── 송신(sender) 노드 물리 NIC ───────────────────────────────────────────────
# 비우면 default route 인터페이스를 자동 감지한다. 이 스크립트는 talker Pod 가 뜨는
# control-plane(sender) 노드에서 실행해야 한다 — qdisc/분류기는 이 노드의 NIC egress 에 붙는다.
PHYS_IF=

# ── Kubernetes ───────────────────────────────────────────────────────────────
NAMESPACE=tsn-experiment
# sudo 로 실행할 때 root 에 kubeconfig 가 없으면 SUDO_USER 의 ~/.kube/config 를 찾는다.
# 명시하려면 여기에 경로를 적는다 (예: /etc/kubernetes/admin.conf).
KUBECONFIG=

# ── 트래픽 ───────────────────────────────────────────────────────────────────
TS_PORT=6000          # time-sensitive UDP 목적지 포트 (ts_classifier 기본값과 동일)
BE_PORT=5001          # best-effort 홍수 UDP 포트 (udp_sink 가 받아서 버림)
TS_COUNT=10000        # TS 패킷 수
TS_INTERVAL_MS=1      # TS 송신 간격 (ms)
TS_SIZE=128           # TS 패킷 크기 (bytes, 12B 헤더 포함)
FLOOD_MBPS=30         # best-effort 제공 부하 (Mbit/s). SHAPE_MBPS 보다 커야 backlog 가 생긴다
FLOOD_SIZE=1400       # best-effort UDP payload (bytes)

# ── 병목(셰이핑) ─────────────────────────────────────────────────────────────
# sender NIC 의 HTB class 1:10 (listener/sink Pod IP 목적지만) 의 rate/ceil (Mbit/s).
# 0 이면 셰이핑 없이 조건 qdisc 를 root 로 붙인다 = 경합이 없어 latency 비교가 무의미하다.
SHAPE_MBPS=20

# ── 분류기 ───────────────────────────────────────────────────────────────────
MARK_DSCP=1           # 1: TS 패킷 IPv4 DSCP 를 EF(46) 로 재기록 (listener 의 tos 컬럼으로 검증)
TS_PRIORITY=6         # 분류기가 설정할 skb->priority (prio/pfifo_fast 기본 priomap: 6,7 -> band 0)
TS_DSCP=46            # MARK_DSCP=1 일 때 DSCP 값

# ── CPU 부하 축 (선택) ───────────────────────────────────────────────────────
# run 의 [cpu%] > 0 일 때만 stress-ng DaemonSet 을 띄운다.
#   STRESS_NODES=receiver : listener 가 있는 worker(수신) 노드에만 (기본).
#                           sender/control-plane 노드에 부하를 주면 kube-apiserver/CoreDNS 와
#                           talker 페이싱 자체가 흔들려 "네트워크 큐잉" 과 "송신기 CPU 기아" 가 섞인다.
#   STRESS_NODES=all      : 두 노드 모두 (논문처럼 호스트 전체 부하).
STRESS_NODES=receiver
STRESS_WORKERS=2      # stress-ng --cpu N (워커 수). --cpu-load 는 워커당 % 이므로 N 코어의 P% 가 된다

# ── Pod CPU 고정 (선택) ──────────────────────────────────────────────────────
# isolcpus 를 적용한 노드에서만 의미가 있다. -1 = 고정 안 함.
# (5월 측정 VM 에는 isolcpus 가 적용되지 않았다. bind 성공 = 격리 증거가 아니다.)
LISTENER_CPU=-1
TALKER_CPU=-1

# ── Pod CPU 요청 ─────────────────────────────────────────────────────────────
# talker 는 requests==limits (Guaranteed). 1 ms 주기의 마지막 ~200 us busy-wait 가 CFS 쿼터에 걸리면
# 수십 ms throttling 이 jitter 로 기록되므로 한 코어(1)를 준다. 2 vCPU control-plane 에서 Pending 이면 500m.
TALKER_CPU_REQUEST=1
FLOOD_CPU_REQUEST=500m

# ── 결과 ─────────────────────────────────────────────────────────────────────
# <RESULTS_DIR>/<condition>_cpu<N>_run<k>.csv + .meta.json, 보조 로그는 <RESULTS_DIR>/logs/<base>/
RESULTS_DIR=results/k8s

# ── 이미지 ───────────────────────────────────────────────────────────────────
# 재현성을 위해 digest 로 고정하는 것을 권장: python:3.11-slim@sha256:...
IMAGE_PY=python:3.11-slim
IMAGE_STRESS=alexeiled/stress-ng:latest

# ── 네임스페이스 강제 삭제 폴백 ──────────────────────────────────────────────
# cleanup 에서 namespace 가 Terminating 에 걸렸을 때만, 그리고 1 로 켰을 때만 finalizer 를 제거한다.
FORCE_NS_FINALIZE=0

# ── 강행 스위치 (기본 0 = 실패로 멈춘다) ─────────────────────────────────────
# ALLOW_LEGACY_ON_TCX=1 : kernel >= 6.6 인데 step6-ebpf/build/tcx_attach 가 없을 때 legacy clsact 로 강행.
#   Cilium(tcx) 이 TC_ACT_OK 를 먼저 반환하면 분류기는 실행되지 않는다 (ADR-0005) — 카운터가 0 이면 그 상태.
# ALLOW_TUNNEL=1 : Cilium routing-mode 가 native 가 아닐 때 수신 노드 IP 로 셰이핑을 강행. NIC egress 에서
#   Pod IP/UDP 6000 이 캡슐화돼 있어 u32 는 노드 IP 로만 잡히고 분류기는 TS 를 식별하지 못한다.
ALLOW_LEGACY_ON_TCX=0
ALLOW_TUNNEL=0
